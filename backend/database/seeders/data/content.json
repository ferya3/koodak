      "chapters": [
        {
          "id": "c1",
          "title": "شب شده",
          "scene": "night-sky",
          "body": "شب آرامی بود. ابرک کوچولو بالای شهر شناور بود و دنبال دوستش، ماه، می‌گشت. ولی ماه پشت کوه‌ها پنهان شده بود. ابرک از کدام راه برود؟",
          "choices": [
            {
              "id": "a",
              "text": "پرواز بالای کوه‌ها",
              "nextChapterId": "c2"

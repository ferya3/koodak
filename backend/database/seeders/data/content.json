            {
              "id": "b",
              "text": "پرسیدن از جغد دانا",
              "nextChapterId": "c3"
            }
          ]
        },
        {
          "id": "c2",
          "title": "بالای کوه‌ها",
          "scene": "mountains",
          "body": "ابرک آن‌قدر بالا رفت که ستاره‌ها برایش دست تکان دادند. باد خنک گفت: «ماه همین نزدیکی است، فقط کمی صبر کن!»",
          "choices": [
            {
              "id": "a",
              "text": "صبر کردن کنار ستاره‌ها",
              "nextChapterId": "c4"
            }
          ]
        },
        {
          "id": "c3",
          "title": "جغد دانا",
          "scene": "owl-tree",
          "body": "جغد روی شاخه‌ی بلوط نشسته بود. گفت: «هوو هوو! ماه هر شب کمی دیرتر می‌آید. اگر با هم آواز بخوانیم، زودتر پیدایش می‌شود.»",
          "choices": [
            {
              "id": "a",
              "text": "با جغد آواز خواندن",
              "nextChapterId": "c4"
            }
          ]
        },
        {
          "id": "c4",
          "title": "سلام ماه!",
          "scene": "moon-rise",
          "body": "و ناگهان، ماه گرد و نقره‌ای از پشت کوه بیرون آمد و لبخند زد. ابرک کوچولو آن‌قدر خوشحال شد که چند قطره باران شادی بارید. شب بخیر، ابرک!",
          "choices": [],
          "isEnding": true
        }
      ]

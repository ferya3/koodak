APP_NAME=KidsWorld
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://api.kidsworld.local
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kidsworld
DB_USERNAME=kidsworld
DB_PASSWORD=secret

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis

FILESYSTEM_DISK=local
# برای Object Storage (S3 / MinIO):
# FILESYSTEM_DISK=s3
# AWS_ENDPOINT=http://minio:9000
# AWS_USE_PATH_STYLE_ENDPOINT=true

FRONTEND_URL=http://kidsworld.local
PAYMENT_DRIVER=fake
KIDSWORLD_FEATURE_SUBSCRIPTIONS=true
KIDSWORLD_FEATURE_SCHOOLS=false
KIDSWORLD_FEATURE_AI=false
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# گزارش PDF: html | chromium | gotenberg
REPORTS_PDF_DRIVER=gotenberg
GOTENBERG_URL=http://gotenberg:3000
